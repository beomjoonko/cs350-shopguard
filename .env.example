# ─── Supabase ────────────────────────────────────────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
SUPABASE_JWT_SECRET=<your-jwt-secret>        # Settings → API → JWT Settings
SUPABASE_STORAGE_BUCKET=shopguard-evidence

# ─── Database (Supabase PostgreSQL) ─────────────────────────
# Get connection string from Supabase → Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Backend (FastAPI) ──────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Rate limiting (SRS §4.8 REQ-1: 60 req/min per IP)
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── AI Worker ──────────────────────────────────────────────
WORKER_CONCURRENCY=2
CRAWLER_REQUEST_DELAY_MS=1000
CRAWLER_USER_AGENT=ShopGuardBot/1.0

# ─── Frontend (Next.js) ─────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ─── Notifications (SRS §3.4) ───────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FCM_SERVER_KEY=
APNS_KEY_ID=
