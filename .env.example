# ─── Database ───────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=shopguard
MYSQL_USER=shopguard
MYSQL_PASSWORD=changeme

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Backend (FastAPI) ──────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database URL (used by SQLAlchemy / Alembic)
DATABASE_URL=mysql+pymysql://shopguard:changeme@mysql:3306/shopguard

# JWT (RFC 7519 — SRS §5.3)
JWT_SECRET_KEY=replace_me_with_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2 password hashing (RFC 9106 — SRS §5.3)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Rate limiting (SRS §4.8 REQ-1: 60 req/min per IP)
RATE_LIMIT_PER_MINUTE=60

# Account lockout (SRS §4.1 REQ-3: 5 attempts → 30 min lock)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30

# CORS (comma-separated; include HTTPS for production — TC-64 / SEC-2)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

# ─── AI Worker ──────────────────────────────────────────────
WORKER_CONCURRENCY=2
CRAWLER_REQUEST_DELAY_MS=1000
CRAWLER_USER_AGENT=ShopGuardBot/1.0

# Object storage for evidence images (SRS §3.3)
S3_ENDPOINT=
S3_BUCKET=shopguard-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Frontend (Next.js) ─────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ─── Frontend URL (password reset links) ───────────────────
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=60

# ─── Notifications (SRS §3.4) ───────────────────────────────
# Local dev: docker compose includes MailHog — use SMTP_HOST=mailhog SMTP_PORT=1025
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@shopguard.local
FCM_SERVER_KEY=
APNS_KEY_ID=
